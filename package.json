{
  "name": "tsn-settlement-management",
  "version": "0.22.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "test": "node --test",
    "verify": "npm test && npm run build && npm run verify:database && npm run verify:production",
    "verify:database": "DATABASE_URL=postgresql://validation:validation@localhost:5432/validation prisma validate",
    "verify:production": "node scripts/verify-production.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "preversion": "npm run verify",
    "release:patch": "npm version patch -m \"release: v%s\"",
    "release:minor": "npm version minor -m \"release: v%s\"",
    "release:major": "npm version major -m \"release: v%s\"",
    "start": "NODE_ENV=production node server/index.js",
    "db:deploy": "prisma migrate deploy",
    "backup": "sh scripts/backup.sh",
    "restore": "sh scripts/restore.sh"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
