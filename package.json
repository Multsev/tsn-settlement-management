{
  "name": "tsn-prozor",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "test": "node --test",
    "verify": "npm test && npm run build && npm run verify:database",
    "verify:database": "DATABASE_URL=postgresql://validation:validation@localhost:5432/validation prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "preversion": "npm run verify",
    "release:patch": "npm version patch -m \"release: v%s\"",
    "release:minor": "npm version minor -m \"release: v%s\"",
    "release:major": "npm version major -m \"release: v%s\""
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
