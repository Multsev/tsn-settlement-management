generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { resident owner assistant_chairman board_member chairman administrator }
enum ProjectStatus { IDEA ESTIMATION PLANNED FUNDRAISING IN_PROGRESS PAUSED COMPLETED CANCELLED }
enum IssueStatus { NEW ACCEPTED PLANNED IN_PROGRESS WAITING_CONTRACTOR COMPLETED CLOSED }
enum ChargeStatus { OPEN PAID OVERDUE CANCELLED }
enum ProposalStatus { SUBMITTED REVIEW VOTING APPROVED REJECTED CONVERTED }
enum VoteChoice { SUPPORT OPPOSE }
enum ListingType { OFFER REQUEST }
enum ListingStatus { ACTIVE CLOSED ARCHIVED }

model Community {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  memberships  Membership[]
  properties   Property[]
  projects     Project[]
  issues       Issue[]
  charges      Charge[]
  payments     Payment[]
  expenses     Expense[]
  auditLogs    AuditLog[]
  proposals    Proposal[]
  polls        Poll[]
  skills       Skill[]
  listings     Listing[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  fullName     String
  memberships  Membership[]
  charges      Charge[]
  payments     Payment[]
  issues       Issue[]      @relation("IssueAuthor")
  auditLogs    AuditLog[]   @relation("AuditActor")
  proposals    Proposal[]   @relation("ProposalAuthor")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  role        Role      @default(resident)
  approvedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  properties  Property[]
  votes       Vote[]
  skills      MemberSkill[]
  listings    Listing[]
  publicProfile Boolean @default(false)
  publicPhone   Boolean @default(false)
  publicEmail   Boolean @default(false)
  contactPhone  String?
  @@unique([userId, communityId])
}

model Skill {
  id          String        @id @default(cuid())
  communityId String
  name        String
  normalized  String
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MemberSkill[]
  @@unique([communityId, normalized])
}

model MemberSkill {
  membershipId String
  skillId      String
  isPublic     Boolean    @default(true)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([membershipId, skillId])
}

model Listing {
  id           String        @id @default(cuid())
  communityId  String
  membershipId String
  type         ListingType
  status       ListingStatus @default(ACTIVE)
  title        String
  description  String
  category     String
  community    Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Property {
  id           String      @id @default(cuid())
  communityId  String
  membershipId String?
  number       String
  street       String
  community    Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  membership   Membership? @relation(fields: [membershipId], references: [id])
  charges      Charge[]
  @@unique([communityId, number])
}

model Project {
  id          String        @id @default(cuid())
  communityId String
  title       String
  description String
  category    String
  status      ProjectStatus @default(IDEA)
  budget      Int           @default(0)
  collected   Int           @default(0)
  spent       Int           @default(0)
  progress    Int           @default(0)
  deadline    DateTime?
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updates     ProjectUpdate[]
  expenses    Expense[]
  proposal    Proposal?     @relation(fields: [proposalId], references: [id])
  proposalId  String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Proposal {
  id                String         @id @default(cuid())
  communityId       String
  authorId          String
  title             String
  description       String
  category          String
  preliminaryBudget Int?
  status            ProposalStatus @default(SUBMITTED)
  community         Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author            User           @relation("ProposalAuthor", fields: [authorId], references: [id])
  poll              Poll?
  project           Project?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Poll {
  id              String   @id @default(cuid())
  communityId     String
  proposalId      String   @unique
  eligibleVoters  Int
  quorumPercent   Int      @default(30)
  approvalPercent Int      @default(60)
  opensAt         DateTime @default(now())
  closesAt        DateTime
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  votes           Vote[]
  createdAt       DateTime @default(now())
}

model Vote {
  id           String     @id @default(cuid())
  pollId       String
  membershipId String
  choice       VoteChoice
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@unique([pollId, membershipId])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  message   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Issue {
  id          String      @id @default(cuid())
  communityId String
  authorId    String
  number      Int
  title       String
  description String?
  address     String
  status      IssueStatus @default(NEW)
  dueAt       DateTime?
  responsible String?
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User        @relation("IssueAuthor", fields: [authorId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@unique([communityId, number])
}

model Charge {
  id          String       @id @default(cuid())
  communityId String
  userId      String
  propertyId  String
  amount      Int
  period      String
  status      ChargeStatus @default(OPEN)
  dueAt       DateTime?
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  property    Property     @relation(fields: [propertyId], references: [id])
  payments    Payment[]
  createdAt   DateTime     @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  chargeId    String?
  amount      Int
  paidAt      DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  charge      Charge?   @relation(fields: [chargeId], references: [id])
}

model Expense {
  id          String    @id @default(cuid())
  communityId String
  projectId   String?
  amount      Int
  category    String
  description String
  recipient   String
  spentAt     DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id          String    @id @default(cuid())
  communityId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt   DateTime  @default(now())
}
