generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  resident
  owner
  assistant_chairman
  board_member
  chairman
  administrator
}

enum ProjectStatus {
  IDEA
  ESTIMATION
  PLANNED
  FUNDRAISING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IssueStatus {
  NEW
  ACCEPTED
  PLANNED
  IN_PROGRESS
  WAITING_CONTRACTOR
  COMPLETED
  CLOSED
}

enum PropertyAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChargeStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum ProposalStatus {
  SUBMITTED
  REVIEW
  VOTING
  APPROVED
  REJECTED
  CONVERTED
}

enum VoteChoice {
  SUPPORT
  OPPOSE
}

enum ListingType {
  OFFER
  REQUEST
}

enum ListingStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum KnowledgeType {
  ONBOARDING
  FAQ
  RULE
}

enum CommunityDocumentType {
  CHARTER
  PROTOCOL
  REGULATION
  CONTRACT
  PLAN
  ESTIMATE
  INVOICE
  ACT
  LETTER
  RESPONSE
  OTHER
}

enum DecisionType {
  BOARD
  GENERAL_MEETING
  CHAIRMAN
  POLL
  OTHER
}

enum DecisionStatus {
  ADOPTED
  IN_PROGRESS
  EXECUTED
  CANCELLED
}

enum FundraiserStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Community {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  address                 String?
  memberships             Membership[]
  properties              Property[]
  streets                 Street[]
  propertyAccessRequests  PropertyAccessRequest[]
  projects                Project[]
  issues                  Issue[]
  charges                 Charge[]
  payments                Payment[]
  expenses                Expense[]
  auditLogs               AuditLog[]
  proposals               Proposal[]
  polls                   Poll[]
  skills                  Skill[]
  listings                Listing[]
  serviceContacts         ServiceContact[]
  knowledgeArticles       KnowledgeArticle[]
  documents               CommunityDocument[]
  decisions               Decision[]
  contractors             Contractor[]
  fundraisers             Fundraiser[]
  fundraiserContributions FundraiserContribution[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model ServiceContact {
  id          String    @id @default(cuid())
  communityId String
  title       String
  contactName String?
  phone       String?
  email       String?
  note        String?
  sortOrder   Int       @default(0)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model KnowledgeArticle {
  id          String        @id @default(cuid())
  communityId String
  type        KnowledgeType
  title       String
  content     String
  sortOrder   Int           @default(0)
  published   Boolean       @default(true)
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CommunityDocument {
  id           String                @id @default(cuid())
  communityId  String
  projectId    String?
  decisionId   String?
  expenseId    String?
  contractorId String?
  uploadedById String?
  type         CommunityDocumentType
  title        String
  url          String
  description  String?
  documentDate DateTime?
  published    Boolean               @default(true)
  community    Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id])
  decision     Decision?             @relation(fields: [decisionId], references: [id])
  expense      Expense?              @relation(fields: [expenseId], references: [id])
  contractor   Contractor?           @relation(fields: [contractorId], references: [id])
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  fullName     String
  memberships  Membership[]
  charges      Charge[]
  payments     Payment[]
  issues       Issue[]      @relation("IssueAuthor")
  auditLogs    AuditLog[]   @relation("AuditActor")
  proposals    Proposal[]   @relation("ProposalAuthor")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id                      String                   @id @default(cuid())
  userId                  String
  communityId             String
  role                    Role                     @default(resident)
  approvedAt              DateTime?
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  community               Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  properties              Property[]
  votes                   Vote[]
  skills                  MemberSkill[]
  listings                Listing[]
  fundraiserContributions FundraiserContribution[]
  propertyAccessRequests  PropertyAccessRequest[]
  publicProfile           Boolean                  @default(false)
  publicPhone             Boolean                  @default(false)
  publicEmail             Boolean                  @default(false)
  contactPhone            String?

  @@unique([userId, communityId])
}

model Skill {
  id          String        @id @default(cuid())
  communityId String
  name        String
  normalized  String
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MemberSkill[]

  @@unique([communityId, normalized])
}

model MemberSkill {
  membershipId String
  skillId      String
  isPublic     Boolean    @default(true)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([membershipId, skillId])
}

model Listing {
  id           String        @id @default(cuid())
  communityId  String
  membershipId String
  type         ListingType
  status       ListingStatus @default(ACTIVE)
  title        String
  description  String
  category     String
  community    Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Property {
  id             String                  @id @default(cuid())
  communityId    String
  membershipId   String?
  number         String
  street         String
  streetId       String?
  community      Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  membership     Membership?             @relation(fields: [membershipId], references: [id])
  streetRecord   Street?                 @relation(fields: [streetId], references: [id])
  charges        Charge[]
  accessRequests PropertyAccessRequest[]

  @@unique([communityId, number])
}

model Street {
  id               String     @id @default(cuid())
  communityId      String
  name             String
  roadCondition    String?
  lightingCoverage Int        @default(0)
  note             String?
  community        Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  properties       Property[]
  projects         Project[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([communityId, name])
}

model PropertyAccessRequest {
  id           String               @id @default(cuid())
  communityId  String
  membershipId String
  propertyId   String
  status       PropertyAccessStatus @default(PENDING)
  note         String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  membership   Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([communityId, status])
}

model Project {
  id              String              @id @default(cuid())
  communityId     String
  streetId        String?
  title           String
  description     String
  problem         String?
  expectedResult  String?
  category        String
  status          ProjectStatus       @default(IDEA)
  priority        ProjectPriority     @default(NORMAL)
  responsible     String?
  fundingSource   String?
  budget          Int                 @default(0)
  collected       Int                 @default(0)
  spent           Int                 @default(0)
  progress        Int                 @default(0)
  startAt         DateTime?
  deadline        DateTime?
  beforePhotoUrl  String?
  afterPhotoUrl   String?
  resultNote      String?
  community       Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  street          Street?             @relation(fields: [streetId], references: [id])
  updates         ProjectUpdate[]
  tasks           ProjectTask[]
  history         ProjectHistory[]
  documents       CommunityDocument[]
  decisions       Decision[]
  contractorLinks ProjectContractor[]
  expenses        Expense[]
  fundraisers     Fundraiser[]
  proposal        Proposal?           @relation(fields: [proposalId], references: [id])
  proposalId      String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Proposal {
  id                String         @id @default(cuid())
  communityId       String
  authorId          String
  title             String
  description       String
  category          String
  preliminaryBudget Int?
  status            ProposalStatus @default(SUBMITTED)
  community         Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author            User           @relation("ProposalAuthor", fields: [authorId], references: [id])
  poll              Poll?
  project           Project?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Poll {
  id              String    @id @default(cuid())
  communityId     String
  proposalId      String    @unique
  eligibleVoters  Int
  quorumPercent   Int       @default(30)
  approvalPercent Int       @default(60)
  opensAt         DateTime  @default(now())
  closesAt        DateTime
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  proposal        Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  votes           Vote[]
  decision        Decision?
  createdAt       DateTime  @default(now())
}

model Decision {
  id             String              @id @default(cuid())
  communityId    String
  pollId         String?             @unique
  title          String
  description    String
  basis          String?
  type           DecisionType
  status         DecisionStatus      @default(ADOPTED)
  adoptedBy      String
  supportPercent Int?
  decidedAt      DateTime
  executionNote  String?
  community      Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  poll           Poll?               @relation(fields: [pollId], references: [id])
  projects       Project[]
  documents      CommunityDocument[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Contractor {
  id           String              @id @default(cuid())
  communityId  String
  name         String
  contactName  String?
  phone        String?
  email        String?
  services     String
  rating       Int                 @default(0)
  note         String?
  community    Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  projectLinks ProjectContractor[]
  documents    CommunityDocument[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([communityId, name])
}

model ProjectContractor {
  projectId      String
  contractorId   String
  role           String?
  contractNumber String?
  contractAmount Int?
  warrantyUntil  DateTime?
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@id([projectId, contractorId])
}

model Vote {
  id           String     @id @default(cuid())
  pollId       String
  membershipId String
  choice       VoteChoice
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([pollId, membershipId])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String?
  message   String
  progress  Int?
  photoUrl  String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProjectTask {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  responsible String?
  status      ProjectTaskStatus @default(TODO)
  dueAt       DateTime?
  completedAt DateTime?
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProjectHistory {
  id         String         @id @default(cuid())
  projectId  String
  actorId    String
  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  comment    String?
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
}

model Issue {
  id             String         @id @default(cuid())
  communityId    String
  authorId       String
  number         Int
  title          String
  description    String?
  address        String
  status         IssueStatus    @default(NEW)
  dueAt          DateTime?
  responsible    String?
  beforePhotoUrl String?
  afterPhotoUrl  String?
  resultNote     String?
  community      Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author         User           @relation("IssueAuthor", fields: [authorId], references: [id])
  history        IssueHistory[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([communityId, number])
}

model IssueHistory {
  id         String       @id @default(cuid())
  issueId    String
  actorId    String
  fromStatus IssueStatus?
  toStatus   IssueStatus
  comment    String?
  issue      Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model Charge {
  id          String       @id @default(cuid())
  communityId String
  userId      String
  propertyId  String
  amount      Int
  period      String
  status      ChargeStatus @default(OPEN)
  dueAt       DateTime?
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  property    Property     @relation(fields: [propertyId], references: [id])
  payments    Payment[]
  createdAt   DateTime     @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  chargeId    String?
  amount      Int
  paidAt      DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  charge      Charge?   @relation(fields: [chargeId], references: [id])
}

model Expense {
  id          String              @id @default(cuid())
  communityId String
  projectId   String?
  amount      Int
  category    String
  description String
  recipient   String
  spentAt     DateTime            @default(now())
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project     Project?            @relation(fields: [projectId], references: [id])
  documents   CommunityDocument[]
}

model Fundraiser {
  id              String                   @id @default(cuid())
  communityId     String
  projectId       String?
  title           String
  description     String
  targetAmount    Int
  collectedAmount Int                      @default(0)
  deadline        DateTime?
  status          FundraiserStatus         @default(ACTIVE)
  community       Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project         Project?                 @relation(fields: [projectId], references: [id])
  contributions   FundraiserContribution[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model FundraiserContribution {
  id           String     @id @default(cuid())
  communityId  String
  fundraiserId String
  membershipId String
  amount       Int
  paidAt       DateTime   @default(now())
  community    Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fundraiser   Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id])
}

model AuditLog {
  id          String    @id @default(cuid())
  communityId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt   DateTime  @default(now())
}
